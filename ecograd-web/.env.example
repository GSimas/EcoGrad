# Funções server-side; nunca usar prefixo VITE para segredos.
# Síntese da IA e extração ontológica (DeepSeek). É a mesma chave da cortesia, abaixo.
DEEPSEEK_API_KEY=
# Só o vetor da pergunta na busca por significado: o índice foi vetorizado com o
# gemini-embedding-2, e a DeepSeek não tem embeddings. Sem ela, só essa busca fica desligada.
GEMINI_API_KEY=
# Neo4j desativado na aplicação web; nenhuma credencial de banco necessária.

# Índice da Etapa 2 (ADR 001). A chave é a publicável (anon): é pública por
# desenho — o RLS é somente leitura e não há tabela de escrita alcançável —, e
# por isso leva prefixo VITE. A service_role NUNCA entra aqui: ela só existe na
# carga do índice, vindo do ambiente de quem carrega.
VITE_INDICE_URL=https://unipsxtosltcbtuwnikh.supabase.co
VITE_INDICE_CHAVE=

# UFSCão de cortesia (10 perguntas vitalícias por IP), com a DEEPSEEK_API_KEY acima.
# Sem ela a cortesia fica desligada e a tela só oferece BYOK.
# Teto do projeto, em perguntas. 3.000 ≈ US$ 10 no preço de pico, ≈ US$ 5 fora dele.
CORTESIA_TETO_PERGUNTAS=3000
# Sal do hash do IP: troque por um valor próprio antes de publicar.
CORTESIA_SAL=
# Só em desenvolvimento: aceita a contagem em memória quando não há Netlify Blobs.
CORTESIA_MEMORIA=
