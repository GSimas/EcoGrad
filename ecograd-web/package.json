{
  "name": "ecograd-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "dev": "npm run sync:data && vite",
    "build": "npm run sync:data && tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "netlify:dev": "node scripts/netlify-dev.mjs",
    "verify:parity": "bash scripts/verify-parity.sh",
    "test:capes": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/capes.test.js",
    "test:workers": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/worker-tasks.test.js",
    "test:selecao": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/selecao.test.js",
    "test:session": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/session.test.js",
    "test:navigation": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/navigation.test.js",
    "test:colecoes": "npm run sync:data && tsc -p tests/tsconfig.json && node tests/collection-metadata.test.mjs && node node_modules/.cache/capes-tests/tests/colecoes.test.js",
    "test:resultados": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/resultados.test.js",
    "test:visualizacao": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/visualizacao.test.js",
    "test:interpretacao": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/interpretacao.test.js",
    "test:ia": "tsc -p tests/tsconfig.json && node node_modules/.cache/capes-tests/tests/ia.test.js",
    "indice:derivar": "node --max-old-space-size=4096 scripts/indice-derivar.mjs",
    "indice:carregar:https": "node scripts/indice-carregar-https.mjs",
    "indice:carregar": "node --env-file-if-exists=.env scripts/indice-carregar.mjs",
    "afericao:gabaritos": "node scripts/afericao-gabaritos.mjs --escrever",
    "afericao:triagem": "node scripts/afericao-triagem.mjs",
    "afericao": "tsc -p tests/tsconfig.json && node --max-old-space-size=4096 scripts/afericao-executar.mjs",
    "test:all": "npm run sync:data && tsc -p tests/tsconfig.json && node scripts/test-all.mjs",
    "report:build": "node scripts/report-build.mjs",
    "afericao:amostra-cega": "node --max-old-space-size=4096 scripts/afericao-amostra-cega.mjs",
    "indice:enriquecer": "esbuild scripts/indice-enriquecer.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/indice-enriquecer.mjs && node --max-old-space-size=8192 node_modules/.cache/indice-enriquecer.mjs",
    "afericao:consultar": "node scripts/afericao-consultar.mjs",
    "indice:embeddings": "node --max-old-space-size=4096 scripts/indice-embeddings.mjs",
    "afericao:vetor": "node scripts/afericao-vetor.mjs",
    "indice:conferir": "node scripts/indice-conferir.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@netlify/blobs": "^9.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "echarts-wordcloud": "^2.1.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.474.0",
    "pako": "^2.1.0",
    "papaparse": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.27.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@netlify/functions": "^3.0.0",
    "@types/node": "^22.13.1",
    "@types/pako": "^2.0.3",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "netlify-cli": "^27.4.1",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
