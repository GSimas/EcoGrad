{
  "nodeLocal": "v24.14.1",
  "nodeBuild": "24",
  "engineLockfileCoerentes": true,
  "rotasOrdenadas": true,
  "headersEsperados": {
    "/index.html": {
      "Cache-Control": "public, max-age=0, must-revalidate",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "X-Frame-Options": "SAMEORIGIN"
    },
    "/data/manifest.json": {
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "public, max-age=0, must-revalidate",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "X-Frame-Options": "SAMEORIGIN"
    },
    "/data/colecoes-cobertura.json": {
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "public, max-age=0, must-revalidate",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "X-Frame-Options": "SAMEORIGIN"
    },
    "/data/base_consolidada_ufsc.json.gz": {
      "Content-Type": "application/gzip",
      "Content-Encoding": "identity",
      "Cache-Control": "public, max-age=0, must-revalidate",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "X-Frame-Options": "SAMEORIGIN"
    },
    "/data/base_tcc_ufsc.json.gz": {
      "Content-Type": "application/gzip",
      "Content-Encoding": "identity",
      "Cache-Control": "public, max-age=0, must-revalidate",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "X-Frame-Options": "SAMEORIGIN"
    },
    "/data/colecao-abc.json.gz": {
      "Content-Type": "application/gzip",
      "Content-Encoding": "identity",
      "Cache-Control": "public, max-age=31536000, immutable",
      "Access-Control-Allow-Origin": "*",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "X-Frame-Options": "SAMEORIGIN"
    },
    "/assets/index-abc.js": {
      "Cache-Control": "public, max-age=31536000, immutable",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "X-Frame-Options": "SAMEORIGIN"
    }
  },
  "siteIdLocalEncontrado": false,
  "runtimeRemoto": "não verificado; requer site e configuração AWS_LAMBDA_JS_RUNTIME no provedor",
  "variaveisServidorNecessarias": [
    "GEMINI_API_KEY",
    "NEO4J_URI",
    "NEO4J_USERNAME",
    "NEO4J_PASSWORD"
  ],
  "segredosLidos": false
}
